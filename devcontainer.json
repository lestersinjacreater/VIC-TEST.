{
  "name": "LINDA",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "5173": { "label": "LINDA app", "onAutoForward": "openBrowser" },
    "8000": { "label": "LINDA API" }
  },
  "postCreateCommand": "bash scripts/setup.sh",
  "postAttachCommand": "echo 'Run ./scripts/dev.sh to start LINDA'"
}
