# LINDA backend settings. Copy to backend/.env and edit.
# Never commit real secrets.

# Database. Default is a local SQLite file (no setup needed).
# For PostgreSQL (docker compose up -d db):
# LINDA_DATABASE_URL=postgresql+psycopg://linda:linda@localhost:5432/linda
LINDA_DATABASE_URL=sqlite:///./linda.db

# demo is the only fully implemented mode.
LINDA_MODE=demo

# mock = simulated fraud-intelligence service (default).
# safaricom = disabled placeholder; refuses to run without an approved
# agreement, credentials AND an implemented contract.
LINDA_FRAUD_PROVIDER=mock

# Future authorised Safaricom integration. Leave empty.
LINDA_SAFARICOM_FRAUD_API_BASE_URL=
LINDA_SAFARICOM_FRAUD_API_CLIENT_ID=
LINDA_SAFARICOM_FRAUD_API_CLIENT_SECRET=
LINDA_SAFARICOM_FRAUD_API_AGREEMENT_REF=

# Optional Google Safe Browsing key (server-side only).
LINDA_SAFE_BROWSING_API_KEY=

# Salt for hashing device identifiers. Change for any shared deploy.
LINDA_CLIENT_SALT=change-me-to-a-long-random-string

# Comma-separated list of allowed frontend origins.
LINDA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Abuse controls and retention.
LINDA_RATE_LIMIT_REPORTS=10
LINDA_RATE_LIMIT_WINDOW_SECONDS=600
LINDA_REPORT_RETENTION_DAYS=90

# Simulated review pacing in seconds.
LINDA_SIM_REVIEW_AFTER_S=6
LINDA_SIM_OUTCOME_AFTER_S=14
